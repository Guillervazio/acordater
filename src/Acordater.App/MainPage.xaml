<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acordater.App.ViewModels"
             xmlns:strings="clr-namespace:Acordater.App.Resources.Strings"
             x:Class="Acordater.App.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{x:Static strings:AppResources.AppTitle}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Text="{Binding NewReminderText}"
                   Placeholder="{x:Static strings:AppResources.NewReminderPlaceholder}"
                   ReturnType="Done"
                   ReturnCommand="{Binding AddCommand}"
                   ClearButtonVisibility="WhileEditing" />
            <Button Grid.Column="1"
                    Text="{x:Static strings:AppResources.Add}"
                    Command="{Binding AddCommand}" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Reminders}">
            <CollectionView.EmptyView>
                <Label Text="{x:Static strings:AppResources.EmptyList}"
                       HorizontalOptions="Center"
                       Margin="0,32" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ReminderItem">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,8">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding Text}" FontSize="17" />
                            <Label Text="{Binding When}" FontSize="13" TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="✓"
                                SemanticProperties.Description="{x:Static strings:AppResources.Done}"
                                Command="{Binding CompleteCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
