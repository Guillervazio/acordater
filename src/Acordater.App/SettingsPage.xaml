<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Acordater.App.ViewModels"
             xmlns:strings="clr-namespace:Acordater.App.Resources.Strings"
             x:Class="Acordater.App.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{x:Static strings:AppResources.Settings}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="{x:Static strings:AppResources.Welcome}"
                   IsVisible="{Binding IsFirstRun}"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Label Text="{x:Static strings:AppResources.QuietHoursTitle}" FontSize="20" FontAttributes="Bold" />
            <Label Text="{x:Static strings:AppResources.QuietHoursDescription}" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                <Label Text="{x:Static strings:AppResources.QuietStart}" VerticalOptions="Center" />
                <TimePicker Grid.Column="1" Time="{Binding QuietStart}" Format="HH:mm" />
                <Label Grid.Row="1" Text="{x:Static strings:AppResources.QuietEnd}" VerticalOptions="Center" />
                <TimePicker Grid.Row="1" Grid.Column="1" Time="{Binding QuietEnd}" Format="HH:mm" />
            </Grid>

            <Label Text="{x:Static strings:AppResources.QuietDisabledHint}" FontSize="13" TextColor="{StaticResource Gray500}" />

            <!-- AI interpretation (docs/spec.md, section 5) -->
            <Label Text="{x:Static strings:AppResources.AiTitle}" FontSize="20" FontAttributes="Bold" Margin="0,16,0,0" />
            <Label Text="{x:Static strings:AppResources.AiDescription}" />

            <Picker Title="{x:Static strings:AppResources.AiProviderLabel}"
                    ItemsSource="{Binding ProviderNames}"
                    SelectedIndex="{Binding SelectedProviderIndex}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAiEnabled}">
                <Label Text="{x:Static strings:AppResources.AiApiKey}" FontAttributes="Bold" />
                <Entry Text="{Binding ApiKey}"
                       IsPassword="True"
                       IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False"
                       Placeholder="{x:Static strings:AppResources.AiApiKeyPlaceholder}" />
                <Label Text="{x:Static strings:AppResources.AiModel}" FontAttributes="Bold" />
                <Entry Text="{Binding Model}"
                       IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False"
                       Placeholder="{Binding ModelPlaceholder}" />
                <Button Text="{x:Static strings:AppResources.AiTest}" Command="{Binding TestAiCommand}" />
                <Label Text="{Binding TestResult}" FontSize="13" />
            </VerticalStackLayout>

            <!-- Wake word (docs/spec.md, section 4.7) -->
            <Label Text="{x:Static strings:AppResources.WakeWordTitle}" FontSize="20" FontAttributes="Bold" Margin="0,16,0,0" />
            <Label Text="{x:Static strings:AppResources.WakeWordDescription}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <Label Text="{x:Static strings:AppResources.WakeWordEnable}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding WakeWordEnabled}" />
            </Grid>
            <Label Text="{Binding WakeWordStatus}" FontSize="13" />

            <Label Text="{Binding WakeWordModel}" />
            <Button Text="{x:Static strings:AppResources.WakeWordImportModel}" Command="{Binding ImportWakeWordModelCommand}" />
            <Button Text="{x:Static strings:AppResources.WakeWordRemoveModel}"
                    Command="{Binding RemoveWakeWordModelCommand}"
                    IsVisible="{Binding HasCustomWakeWord}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

            <Button Text="{x:Static strings:AppResources.Save}" Command="{Binding SaveCommand}" Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
